{
  "name": "qr-tree",
  "version": "0.1.0",
  "description": "A QR code that grows into a tree. Tap it and the blossoms fall into a scannable code. Built with three.js.",
  "keywords": [
    "qr",
    "qrcode",
    "qr-code",
    "three",
    "threejs",
    "webgl",
    "animation",
    "tree",
    "react"
  ],
  "author": "Susana Rojas",
  "license": "MIT",
  "homepage": "https://github.com/SRojas22/QR_Tree#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SRojas22/QR_Tree.git"
  },
  "bugs": {
    "url": "https://github.com/SRojas22/QR_Tree/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite examples",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "prepare": "tsup"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "react": ">=18",
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsqr": "^1.4.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "three": "^0.182.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
